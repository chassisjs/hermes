{
  "name": "@chassisjs/hermes-mysql",
  "version": "1.0.0-alpha.22",
  "description": "Production-Ready TypeScript Outbox Pattern for MySQL",
  "scripts": {
    "build": "rollup -c",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "clean": "rm -rf ./lib/",
    "lint:eslint": "eslint 'src/**/*.ts'",
    "lint:prettier": "prettier --check \"**/**/!(*.d).{ts,json,md}\"",
    "fix:prettier": "prettier --write \"**/**/!(*.d).{ts,json,md}\"",
    "lint-fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --colors --coverage --verbose --detectOpenHandles --forceExit --maxConcurrency=1",
    "typecheck": "tsc --noEmit",
    "typedoc": "typedoc --favicon public/favicon.ico",
    "typedoc:watch": "typedoc --favicon public/favicon.ico --watch"
  },
  "keywords": [
    "outbox",
    "mysql",
    "aurora",
    "microservices",
    "messaging",
    "transactional",
    "events"
  ],
  "author": {
    "name": "Artur Wojnar",
    "email": "contact@arturwojnar.dev"
  },
  "engines": {
    "node": ">=18.20.3"
  },
  "homepage": "https://docs.hermesjs.tech",
  "license": "ISC",
  "type": "module",
  "main": "./lib/index.cjs",
  "types": "./lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chassisjs/hermes.git",
    "directory": "packages/hermes-mysql"
  },
  "bugs": {
    "url": "https://github.com/chassisjs/hermes/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@jest/globals": "~30.5.2",
    "@testcontainers/mysql": "~12.2.1",
    "kysely": "^0.29.8",
    "testcontainers": "~12.2.1"
  },
  "dependencies": {
    "mysql2": "~3.24.6"
  },
  "peerDependencies": {
    "@chassisjs/hermes": "~1.0.0-alpha.22"
  }
}
